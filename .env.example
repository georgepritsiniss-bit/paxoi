# --- Supabase ---
# Get these from https://app.supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only key. Used by the admin panel for privileged actions.
# NEVER expose this on the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin Panel ---
# Hardcoded admin credentials for /admin (default: root / root)
ADMIN_USERNAME=root
ADMIN_PASSWORD=root
# Random long string used to sign the admin session cookie
ADMIN_SESSION_SECRET=please-change-me-to-a-long-random-string

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
